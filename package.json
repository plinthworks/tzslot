{
  "name": "tzslot-workspace",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p packages/core/tsconfig.json --noEmit",
    "start": "vite",
    "test:memory": "NODE_OPTIONS=--expose-gc vitest run packages/core/test/perf.test.ts",
    "build:theme": "sass --no-source-map --style=expanded packages/theme/tzslot.scss packages/theme/tzslot.css"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.7.2",
    "@angular/build": "^21.2.24",
    "@angular/common": "^21.2.23",
    "@angular/compiler": "^21.2.23",
    "@angular/compiler-cli": "^21.2.23",
    "@angular/core": "^21.2.23",
    "@angular/platform-browser": "^21.2.23",
    "jsdom": "^29.1.1",
    "sass": "^1.104.1",
    "typescript": "^5.9.0",
    "vitest": "^4.0.8"
  },
  "dependencies": {
    "@angular/forms": "^21.2.23",
    "temporal-polyfill": "^1.0.5"
  },
  "peerDependencies": {
    "@angular/common": "^21.2.23",
    "@angular/core": "^21.2.23"
  }
}
