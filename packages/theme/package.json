{
  "name": "@tzslot/theme",
  "version": "1.0.1",
  "description": "An optional stylesheet for the tzslot components. Plain CSS, no framework.",
  "license": "MIT",
  "main": "./tzslot.css",
  "exports": {
    ".": "./tzslot.css",
    "./tzslot.css": "./tzslot.css",
    "./contrast.css": "./contrast.css",
    "./tzslot.scss": "./tzslot.scss",
    "./tzslot": {
      "sass": "./tzslot.scss",
      "default": "./tzslot.css"
    },
    "./tailwind.css": "./tailwind.css",
    "./tailwind3.css": "./tailwind3.css"
  },
  "files": [
    "tzslot.css",
    "tzslot.scss",
    "contrast.css",
    "tailwind.css",
    "tailwind3.css"
  ],
  "sideEffects": [
    "*.css"
  ],
  "sass": "./tzslot.scss"
}
